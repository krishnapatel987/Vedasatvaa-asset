
document.addEventListener('DOMContentLoaded',()=>{const menuToggle=document.querySelector('.menu-toggle');const mainNav=document.querySelector('.main-navigation');if(menuToggle&&mainNav){menuToggle.addEventListener('click',()=>{const isActive=menuToggle.classList.toggle('is-active');mainNav.classList.toggle('is-active');menuToggle.setAttribute('aria-expanded',isActive)})}
const heroSwiper=new Swiper('.hero-swiper',{loop:!0,speed:1000,autoplay:{delay:5000,disableOnInteraction:!1,},pagination:{el:'.hero-pagination',clickable:!0,},breakpoints:{320:{slidesPerView:1,spaceBetween:0}}});const testimonialsSwiper=new Swiper('.testimonials-swiper',{slidesPerView:3,spaceBetween:32,loop:!0,autoplay:{delay:3000,disableOnInteraction:!1,},pagination:{el:'.testimonials-pagination',clickable:!0,},breakpoints:{320:{slidesPerView:1,spaceBetween:16},768:{slidesPerView:2,spaceBetween:24},1024:{slidesPerView:3,spaceBetween:32}}});const recommendationImageSwiper=new Swiper('.recommendation-image-swiper',{slidesPerView:1,spaceBetween:20,loop:!0,navigation:{nextEl:'.recommendation-next',prevEl:'.recommendation-prev',},});const recommendationContentSwiper=new Swiper('.recommendation-content-swiper',{slidesPerView:1,spaceBetween:20,loop:!0,allowTouchMove:!1,});recommendationImageSwiper.controller.control=recommendationContentSwiper;recommendationContentSwiper.controller.control=recommendationImageSwiper;const addtoCartBtns=document.querySelectorAll('.ajax-add-to-cart');addtoCartBtns.forEach(btn=>{btn.addEventListener('click',async(e)=>{e.preventDefault();const productId=btn.dataset.product_id;const originalText=btn.innerHTML;btn.classList.add('loading');btn.innerHTML='Adding...';try{const formData=new FormData();formData.append('action','woocommerce_add_to_cart');formData.append('product_id',productId);formData.append('quantity',1);const response=await fetch(window.location.href,{method:'POST',body:new URLSearchParams({'add-to-cart':productId})});if(response.ok){btn.innerHTML='Added! ✓';if(typeof veda_satvaa_wc_settings!=='undefined'){if(veda_satvaa_wc_settings.is_custom_redirect==='yes'&&veda_satvaa_wc_settings.redirect_url){window.location.href=veda_satvaa_wc_settings.redirect_url;return}else if(veda_satvaa_wc_settings.cart_redirect_after_add==='yes'){window.location.href=veda_satvaa_wc_settings.cart_url;return}}
document.body.dispatchEvent(new CustomEvent('added_to_cart',{detail:{product_id:productId}}));setTimeout(()=>{btn.innerHTML=originalText},2000)}}catch(error){console.error('Error adding to cart:',error);btn.innerHTML='Error';setTimeout(()=>{btn.innerHTML=originalText},2000)}})});const faqItems=document.querySelectorAll('.faq-item');faqItems.forEach(item=>{if(item.classList.contains('active')){const answer=item.querySelector('.faq-answer');answer.style.height=answer.scrollHeight+'px'}});faqItems.forEach(item=>{const question=item.querySelector('.faq-question');question.addEventListener('click',()=>{const isActive=item.classList.contains('active');const answer=item.querySelector('.faq-answer');faqItems.forEach(otherItem=>{if(otherItem!==item&&otherItem.classList.contains('active')){otherItem.classList.remove('active');otherItem.querySelector('.faq-answer').style.height='0px'}});if(isActive){item.classList.remove('active');answer.style.height='0px'}else{item.classList.add('active');answer.style.height=answer.scrollHeight+'px'}})});const videoIframe=document.getElementById('about-video-iframe');if(videoIframe){const observerOptions={root:null,rootMargin:'0px',threshold:0.5};const videoObserver=new IntersectionObserver((entries)=>{entries.forEach(entry=>{if(entry.isIntersecting){videoIframe.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}','*')}else{videoIframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}','*')}})},observerOptions);videoObserver.observe(videoIframe)}
const thumbItems=document.querySelectorAll('.thumb-item');const mainImage=document.getElementById('main-product-image');if(thumbItems.length>0&&mainImage){thumbItems.forEach(thumb=>{thumb.addEventListener('click',()=>{const largeSrc=thumb.getAttribute('data-large-src');mainImage.src=largeSrc;thumbItems.forEach(t=>t.classList.remove('active'));thumb.classList.add('active')})})}
const cartQtySelectors=document.querySelectorAll('.cart-items-body .quantity-selector');if(cartQtySelectors.length>0){cartQtySelectors.forEach(selector=>{const minusBtn=selector.querySelector('.minus');const plusBtn=selector.querySelector('.plus');const qtyDisplay=selector.querySelector('.qty-number');const qtyInput=selector.querySelector('.qty-input');const updateBtn=document.getElementById('update-cart-submit');minusBtn.addEventListener('click',()=>{let currentQty=parseInt(qtyDisplay.textContent);if(currentQty>1){currentQty--;qtyDisplay.textContent=currentQty;qtyInput.value=currentQty;if(updateBtn){updateBtn.removeAttribute('disabled');updateBtn.click()}}});plusBtn.addEventListener('click',()=>{let currentQty=parseInt(qtyDisplay.textContent);currentQty++;qtyDisplay.textContent=currentQty;qtyInput.value=currentQty;if(updateBtn){updateBtn.removeAttribute('disabled');updateBtn.click()}})})}
const qtySelector=document.querySelector('.product-detail-section .quantity-selector');const buyNowBtn=document.querySelector('.buy-now-btn');if(qtySelector){const minusBtn=qtySelector.querySelector('.minus');const plusBtn=qtySelector.querySelector('.plus');const qtyDisplay=qtySelector.querySelector('.qty-number');const qtyInput=document.getElementById('product_qty_input');const updateBuyNowLink=(qty)=>{if(buyNowBtn){try{const url=new URL(buyNowBtn.href);url.searchParams.set('quantity',qty);buyNowBtn.href=url.toString()}catch(e){const separator=buyNowBtn.href.includes('?')?'&':'?';if(buyNowBtn.href.includes('quantity=')){buyNowBtn.href=buyNowBtn.href.replace(/quantity=\d+/,'quantity='+qty)}else{buyNowBtn.href=buyNowBtn.href+separator+'quantity='+qty}}}};minusBtn.addEventListener('click',()=>{let currentQty=parseInt(qtyDisplay.textContent);if(currentQty>1){currentQty--;qtyDisplay.textContent=currentQty;qtyInput.value=currentQty;updateBuyNowLink(currentQty)}});plusBtn.addEventListener('click',()=>{let currentQty=parseInt(qtyDisplay.textContent);currentQty++;qtyDisplay.textContent=currentQty;qtyInput.value=currentQty;updateBuyNowLink(currentQty)});updateBuyNowLink(parseInt(qtyDisplay.textContent))}
const removeLinks=document.querySelectorAll('.product-remove a');removeLinks.forEach(link=>{link.addEventListener('click',async(e)=>{e.preventDefault();const url=link.getAttribute('href');const row=link.closest('.cart-item-row');if(row){row.style.opacity='0.5';row.style.pointerEvents='none'}
try{const response=await fetch(url);window.location.reload()}catch(error){console.error('Error removing item:',error);window.location.reload()}})});const productAccordions=document.querySelectorAll('.product-accordion-item');if(productAccordions.length>0){productAccordions.forEach(item=>{const toggle=item.querySelector('.accordion-toggle');const content=item.querySelector('.accordion-content');const icon=toggle.querySelector('.accordion-icon');toggle.addEventListener('click',()=>{const isOpen=toggle.classList.contains('is-active');if(isOpen){toggle.classList.remove('is-active');toggle.setAttribute('aria-expanded','false');content.style.maxHeight=null;icon.textContent='+'}else{toggle.classList.add('is-active');toggle.setAttribute('aria-expanded','true');content.style.maxHeight=content.scrollHeight+"px";icon.textContent='×'}})})}});


